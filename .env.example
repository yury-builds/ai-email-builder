# Anthropic key for the AI planner (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-...

# Resend key for sending test emails
RESEND_API_KEY=re_...

# From address Resend will send as (must be on a verified domain or "onboarding@resend.dev")
RESEND_FROM="Email Studio <onboarding@resend.dev>"

# Optional model override
ANTHROPIC_MODEL=claude-sonnet-4-6
