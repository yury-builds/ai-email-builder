# Anthropic key for the AI planner (Claude Sonnet 5.5)
ANTHROPIC_API_KEY=sk-ant-...

# Resend key for sending test emails
RESEND_API_KEY=re_...

# From address Resend will send as (must be on a verified domain or "onboarding@resend.dev")
RESEND_FROM="Email Studio <onboarding@resend.dev>"

# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional planner tuning (unset = thinking off, effort medium, max_tokens 4096 / 16000 with adaptive thinking)
# ANTHROPIC_THINKING=adaptive   # model thinks before editing: deeper, but ops start streaming later
# ANTHROPIC_EFFORT=medium       # low | medium | high (xhigh | max need ANTHROPIC_THINKING=adaptive)
# ANTHROPIC_MAX_TOKENS=4096
