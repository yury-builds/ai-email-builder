# Anthropic key for the AI planner (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-...

# Resend key for sending test emails
RESEND_API_KEY=re_...

# From address Resend will send as (must be on a verified domain or "onboarding@resend.dev")
RESEND_FROM="Email Studio <onboarding@resend.dev>"

# Optional model override
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional planner tuning (unset = current defaults: max_tokens=2048 / 4096+ with thinking, temperature omitted, thinking off)
# ANTHROPIC_MAX_TOKENS=2048
# ANTHROPIC_TEMPERATURE=1
# ANTHROPIC_THINKING_BUDGET=2048   # >=1024 to enable extended thinking; incompatible with temperature
